[mcp_servers.change_trace]
command = "npx"
args = ["-y", "change-trace-mcp@<VERSION>"]
required = true
startup_timeout_sec = 10
tool_timeout_sec = 60
enabled_tools = ["collect_external_evidence", "collect_local_evidence", "collect_runtime_evidence", "get_change_scope", "get_compatibility_fixture", "get_review_bundle", "get_server_info", "validate_findings", "write_report"]

# Set an approval policy only after reviewing the server and your project.
