{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "change-trace": {
        "type": "local",
        "command": ["npx", "-y", "change-trace-mcp@<VERSION>"],
        "disabled": false,
        "codemode": false,
        "timeout": {
          "startup": 10000,
          "catalog": 10000,
          "execution": 60000
        }
      }
    }
  }
}
